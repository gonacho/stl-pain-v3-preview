---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TherapeuticProcedureSchema from '../../components/schemas/TherapeuticProcedureSchema.astro';
import MedicalWebPageSchema from '../../components/schemas/MedicalWebPageSchema.astro';
import BreadcrumbSchema from '../../components/schemas/BreadcrumbSchema.astro';
import FAQPageSchema from '../../components/schemas/FAQPageSchema.astro';
import ConditionCard from '../../components/ConditionCard.astro';
import Testimonials from '../../components/Testimonials.astro';
import FAQ from '../../components/FAQ.astro';
import CTA from '../../components/CTA.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { SITE_URL } from '../../data/site-config';

export async function getStaticPaths() {
  const services = await getCollection('services');
  const nestedServices = services.filter(s => s.slug.includes('/') && !s.slug.startsWith('standalone/'));
  return nestedServices.map(s => {
    const parts = s.slug.split('/');
    return {
      params: { category: parts[0], service: parts[1] },
      props: { service: s },
    };
  });
}

const { service } = Astro.props;
const { Content } = await service.render();
const slug = service.slug.split('/').pop() ?? service.slug;
const url = `/${service.data.categorySlug}/${slug}/`;

// Get conditions that link to this service
const allConditions = await getCollection('conditions');
const relatedConditions = allConditions.filter(c =>
  c.data.treatment_services.includes(slug)
);

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: service.data.categoryName, url: `/${service.data.categorySlug}/` },
  { name: service.data.h1.split(' in ')[0], url },
];

const serviceReviews = service.data.testimonials
  .filter(t => ['service-page', 'therapeuticprocedure'].includes(t.schema_binding))
  .map(r => ({ author: r.author, date: r.date, rating: r.rating, text: r.text }));
---
<BaseLayout title={service.data.title} description={service.data.description} image={service.data.heroImage}>
  <Fragment slot="schema">
    <TherapeuticProcedureSchema
      name={service.data.h1.split(' in ')[0]}
      slug={slug}
      url={url}
      description={service.data.description}
      indications={service.data.indications}
      reviews={serviceReviews}
      schemaType={service.data.schemaType}
      categoryName={service.data.categoryName}
      datePublished={service.data.publishDate}
      dateModified={service.data.lastEdited}
    />
    <MedicalWebPageSchema
      title={service.data.title}
      description={service.data.description}
      url={url}
      datePublished={service.data.publishDate}
      dateModified={service.data.lastEdited}
      mainEntityId={`${SITE_URL}/#service-${slug}`}
      aspect="Treatment"
      includeInstitutionalAnchor={true}
    />
    <BreadcrumbSchema items={breadcrumbs} />
    {service.data.faqs.length > 0 && <FAQPageSchema faqs={service.data.faqs} />}
  </Fragment>

  <!-- Hero -->
  <section class="relative bg-brand-navy min-h-[55vh] flex items-center overflow-hidden">
    {service.data.heroImage && (
      <img
        src={service.data.heroImage}
        alt={service.data.heroImageAlt ?? service.data.h1}
        width="1200"
        height="630"
        class="absolute inset-0 w-full h-full object-cover opacity-30"
        fetchpriority="high"
        loading="eager"
      />
    )}
    <div class="absolute inset-0" style="background: linear-gradient(135deg, rgba(27,58,92,0.97) 0%, rgba(27,58,92,0.80) 55%, rgba(15,30,50,0.70) 100%);"></div>
    <div aria-hidden="true" class="absolute top-12 right-12 w-72 h-72 rounded-full opacity-15 blur-3xl" style="background: radial-gradient(circle, #C8A04A 0%, transparent 70%);"></div>
    <div class="container relative z-10 py-16 lg:py-20">
      <Breadcrumb items={breadcrumbs} />
      <div class="max-w-3xl mt-4">
        <p class="eyebrow text-brand-gold mb-4 gsap-reveal">{service.data.categoryName}</p>
        <h1 class="text-5xl lg:text-7xl font-display font-bold text-white mb-5 gsap-reveal" style="letter-spacing:-0.03em; line-height:1.0">
          {service.data.h1.split(' in ')[0]}
          {service.data.h1.includes(' in ') && (
            <span class="text-gradient-gold block mt-1">in {service.data.h1.split(' in ').slice(1).join(' in ')}</span>
          )}
        </h1>
        <p class="text-white/70 text-lg max-w-2xl gsap-reveal leading-relaxed mb-8">{service.data.description}</p>
        <div class="flex flex-wrap gap-4 gsap-reveal">
          <a
            href="/contact/"
            class="btn-shine relative overflow-hidden inline-flex items-center gap-2 bg-gradient-to-r from-brand-gold to-brand-gold-dark text-white font-semibold px-7 py-3.5 rounded-xl text-sm shadow-brand-lg hover:shadow-brand-xl transition-shadow"
          >
            <span class="shine-sweep absolute inset-0 pointer-events-none" style="background: linear-gradient(90deg, transparent, rgba(255,255,255,0.28), transparent); transform: translateX(-110%);"></span>
            Book Appointment
          </a>
          <a href={`/${service.data.categorySlug}/`} class="inline-flex items-center gap-1.5 text-white/60 hover:text-white text-sm font-medium transition-colors">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"/></svg>
            {service.data.categoryName}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Institutional anchor mention (visible body copy) -->
  <section class="bg-white py-4 border-b border-amber-100">
    <div class="container max-w-prose">
      <p class="text-sm text-brand-body/70 italic">
        St. Louis Pain Center is conveniently located in the south St. Louis community, serving the same area as Washington University School of Medicine-affiliated practices.
      </p>
    </div>
  </section>

  <!-- Main content -->
  <section class="section bg-brand-warm">
    <div class="container max-w-prose">
      <div class="prose prose-lg prose-headings:font-display prose-headings:text-brand-navy prose-a:text-brand-teal">
        <Content />
      </div>
    </div>
  </section>

  <!-- Related conditions (links UP) -->
  {relatedConditions.length > 0 && (
    <section class="section bg-white">
      <div class="container">
        <h2 class="text-3xl font-display font-bold text-brand-navy mb-8 gsap-reveal">Conditions This Treatment Addresses</h2>
        <div class="card-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
          {relatedConditions.map(c => (
            <ConditionCard
              name={c.data.h1}
              url={`/conditions/${c.data.conditionSlug}/`}
              image={c.data.heroImage}
              imageAlt={c.data.heroImageAlt}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Testimonials if any -->
  {service.data.testimonials.length > 0 && (
    <Testimonials
      testimonials={service.data.testimonials.map(t => ({ author: t.author, text: t.text, rating: t.rating }))}
    />
  )}

  {service.data.faqs.length > 0 && <FAQ faqs={service.data.faqs} />}
  <CTA />
</BaseLayout>
