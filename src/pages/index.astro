---
import BaseLayout from '../layouts/BaseLayout.astro';
import OrganizationSchema from '../components/schemas/OrganizationSchema.astro';
import LocalBusinessSchema from '../components/schemas/LocalBusinessSchema.astro';
import MedicalWebPageSchema from '../components/schemas/MedicalWebPageSchema.astro';
import WebSiteSchema from '../components/schemas/WebSiteSchema.astro';
import BreadcrumbSchema from '../components/schemas/BreadcrumbSchema.astro';
import FAQPageSchema from '../components/schemas/FAQPageSchema.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ConditionCard from '../components/ConditionCard.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import { SITE_PHONE_DISPLAY, BOOKING_URL, HOMEPAGE_REVIEWS } from '../data/site-config';

const PUBLISH_DATE = new Date('2026-05-19');
const LAST_EDITED = new Date('2026-05-20');

const stats = [
  { value: 7, suffix: '+', label: 'Years Serving St. Louis' },
  { value: 11, suffix: '', label: 'Specialist Services' },
  { value: 4.9, suffix: '/5', label: 'Google Rating' },
  { value: 47, suffix: '+', label: 'Verified Reviews' },
];

const allServices = [
  { name: 'Nerve Blocks', url: '/pain-control/nerve-blocks/', description: 'Targeted nerve block injections for back pain, neck pain, and sciatica relief.', category: 'Pain Control', image: '/images/pain-control/nerve-blocks-st-louis-mo.webp' },
  { name: 'Injection Therapy', url: '/pain-control/injection-therapy/', description: 'Therapeutic injections for back, neck, and shoulder conditions.', category: 'Pain Control', image: '/images/pain-control/injection-therapy-st-louis-mo.webp' },
  { name: 'Kyphoplasty', url: '/pain-control/kyphoplasty/', description: 'Minimally invasive procedure for spinal compression fracture pain.', category: 'Pain Control', image: '/images/pain-control/kyphoplasty-st-louis-mo.webp' },
  { name: 'Medication Management', url: '/pain-control/medication-management/', description: 'Personalized pain medication management for chronic conditions.', category: 'Pain Control', image: '/images/pain-control/medication-management-st-louis-mo.webp' },
  { name: 'Neuropathy Treatment', url: '/pain-control/neuropathy-treatment/', description: 'Comprehensive peripheral neuropathy diagnosis and treatment.', category: 'Pain Control', image: '/images/pain-control/neuropathy-treatment-st-louis-mo.webp' },
  { name: 'Neuromodulation Technique', url: '/pain-control/neuromodulation-technique/', description: 'Drug-free neuromodulation for neuropathy and chronic pain.', category: 'Pain Control', image: '/images/pain-control/neuromodulation-technique-st-louis-mo.webp' },
  { name: 'Hyaluronic Acid Injections', url: '/orthopedic/hyaluronic-acid-injections/', description: 'Gel injections for knee and joint pain without surgery.', category: 'Orthopedic', image: '/images/orthopedic/hyaluronic-acid-injections-st-louis-mo.webp' },
  { name: 'PRP Therapy', url: '/orthopedic/prp-therapy/', description: 'Platelet-rich plasma for tissue regeneration and joint healing.', category: 'Orthopedic', image: '/images/orthopedic/prp-therapy-st-louis-mo.webp' },
  { name: 'Regenerative Therapy', url: '/orthopedic/regenerative-therapy/', description: 'Advanced regenerative medicine for joints and soft tissue.', category: 'Orthopedic', image: '/images/orthopedic/regenerative-therapy-st-louis-mo.webp' },
  { name: 'Medical Weight Loss', url: '/weight-loss/', description: 'Physician-supervised weight loss with GLP-1 medications.', category: 'Weight Loss', image: '/images/weight-loss/medical-weight-loss-st-louis-mo.webp' },
  { name: 'Physical Therapy', url: '/sports-medicine/', description: 'Physical therapy and rehabilitation for pain and mobility.', category: 'Sports Medicine', image: '/images/sports-medicine/physical-therapy-st-louis-mo.webp' },
];

const allConditions = [
  { name: 'Neuropathy', url: '/conditions/neuropathy/', image: '/images/conditions/neuropathy-st-louis-mo-illustration.webp' },
  { name: 'Diabetic Neuropathy', url: '/conditions/diabetic-neuropathy/', image: '/images/conditions/diabetic-neuropathy-st-louis-mo-illustration.webp' },
  { name: 'Knee Pain', url: '/conditions/knee-pain/', image: '/images/conditions/knee-pain-st-louis-mo.webp' },
  { name: 'Joint Pain', url: '/conditions/joint-pain/', image: '/images/conditions/joint-pain-st-louis-mo-illustration.webp' },
  { name: 'Back Pain', url: '/conditions/back-pain/', image: '/images/conditions/back-pain-st-louis-mo-illustration.webp' },
  { name: 'Neck Pain', url: '/conditions/neck-pain/', image: '/images/conditions/neck-pain-st-louis-mo-illustration.webp' },
  { name: 'Sciatica', url: '/conditions/sciatica/', image: '/images/conditions/sciatica-st-louis-mo-illustration.webp' },
  { name: 'Chronic Pain', url: '/conditions/chronic-pain/', image: '/images/conditions/chronic-pain-st-louis-mo-illustration.webp' },
  { name: 'Shoulder Pain', url: '/conditions/shoulder-pain/', image: '/images/conditions/shoulder-pain-st-louis-mo-illustration.webp' },
  { name: 'Arthritis / Osteoarthritis', url: '/conditions/arthritis-osteoarthritis/', image: '/images/conditions/arthritis-osteoarthritis-st-louis-mo-illustration.webp' },
  { name: 'Fibromyalgia', url: '/conditions/fibromyalgia/', image: '/images/conditions/fibromyalgia-st-louis-mo-illustration.webp' },
  { name: 'Vertigo / Vestibular Disorders', url: '/conditions/vertigo-vestibular-disorders/', image: '/images/conditions/vertigo-vestibular-st-louis-mo-illustration.webp' },
  { name: 'Neuropathy in Feet', url: '/conditions/neuropathy-in-feet/', image: '/images/conditions/neuropathy-in-feet-st-louis-mo-illustration.webp' },
];

const testimonials = HOMEPAGE_REVIEWS.map(r => ({ author: r.author, text: r.text, rating: r.rating }));

const whyUsItems = [
  {
    title: 'Targeted Treatments',
    body: 'Every treatment plan is custom-built for your specific condition — no one-size-fits-all protocols.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"/></svg>`,
  },
  {
    title: 'Multimodal Approach',
    body: 'We combine multiple evidence-based therapies for better outcomes than single-treatment protocols.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 0 1-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 0 1 4.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15M14.25 3.104c.251.023.501.05.75.082M19.8 15a2.25 2.25 0 0 1 .45 1.32L20.25 21 12 17.25 3.75 21l.04-4.68A2.25 2.25 0 0 1 4.2 15m15.6 0-3.672-2.524M4.2 15l3.672-2.524m0 0 2.128-1.463"/></svg>`,
  },
  {
    title: 'Medicare Accepted',
    body: 'We work with Medicare, Blue Cross, Aetna, Cigna, and most major insurance plans.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z"/></svg>`,
  },
  {
    title: 'South St. Louis County',
    body: 'Conveniently located at 4455 Telegraph Rd, serving Oakville, Mehlville, and all of south county.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Z"/></svg>`,
  },
];

const insurancePlans = ['Medicare', 'Blue Cross Blue Shield', 'Aetna', 'Cigna', 'United Healthcare', 'Humana', 'Most Major Plans'];

const homepageFaqs = [
  { question: "What is St. Louis Pain Center?", answer: "St. Louis Pain Center is a pain control clinic in St. Louis, MO specializing in neuropathy treatment, orthopedic care, regenerative medicine, physical therapy, and comprehensive pain management for patients throughout south St. Louis County." },
  { question: "Where is St. Louis Pain Center located?", answer: "We are located at 4455 Telegraph Rd #250, St. Louis, MO 63129. We serve patients from Oakville, Mehlville, Arnold, Fenton, Kirkwood, and the greater south St. Louis County area." },
  { question: "What insurances do you accept?", answer: "We accept Medicare, Blue Cross Blue Shield, Aetna, Cigna, and most major commercial insurance plans. Contact us to verify your specific coverage." },
  { question: "How do I schedule an appointment?", answer: "Call us at (314) 846-2100 or use our online booking form. We offer same-week appointments for new patients when available." },
];

const breadcrumbs = [{ name: 'Home', url: '/' }];
---
<BaseLayout
  title="Pain Control Clinic in St. Louis | St. Louis Pain Center"
  description="St. Louis Pain Center — pain control clinic in St. Louis, MO. Neuropathy treatment, orthopedic care, PRP therapy, and comprehensive pain management at 4455 Telegraph Rd."
>
  <Fragment slot="schema">
    <OrganizationSchema />
    <LocalBusinessSchema isHomepage={true} />
    <MedicalWebPageSchema
      title="Pain Control Clinic in St. Louis"
      description="St. Louis Pain Center provides neuropathy treatment, injection therapy, PRP therapy, and comprehensive pain management in St. Louis, MO."
      url="/"
      datePublished={PUBLISH_DATE}
      dateModified={LAST_EDITED}
      mainEntityId="https://stlpaincenter.com/#localbusiness"
      includeInstitutionalAnchor={true}
    />
    <WebSiteSchema />
    <BreadcrumbSchema items={breadcrumbs} />
    <FAQPageSchema faqs={homepageFaqs} />
  </Fragment>

  <!-- ── HERO ── -->
  <section class="relative bg-brand-navy min-h-[90vh] flex items-center overflow-hidden">
    <!-- Video background -->
    <video
      class="absolute inset-0 w-full h-full object-cover opacity-25"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="/images/hero-poster-st-louis-mo.webp"
      aria-hidden="true"
      fetchpriority="high"
    >
      <source src="/video/hero-bg.mp4" type="video/mp4" />
    </video>
    <!-- Gradient overlay -->
    <div class="absolute inset-0" style="background: linear-gradient(135deg, rgba(27,58,92,0.97) 0%, rgba(27,58,92,0.85) 50%, rgba(15,30,50,0.75) 100%);"></div>
    <!-- Gradient mesh blobs -->
    <div aria-hidden="true" class="absolute top-16 right-8 w-[500px] h-[500px] rounded-full opacity-20 blur-3xl" style="background: radial-gradient(circle, #C8A04A 0%, transparent 70%);"></div>
    <div aria-hidden="true" class="absolute bottom-12 left-16 w-72 h-72 rounded-full opacity-15 blur-3xl" style="background: radial-gradient(circle, #0E7C9E 0%, transparent 70%);"></div>

    <div class="container relative z-10 py-24 lg:py-32">
      <div class="max-w-3xl">

        <!-- Eyebrow -->
        <p id="hero-eyebrow" class="eyebrow text-brand-gold mb-5 opacity-0">
          Pain Control Clinic · St. Louis, MO
        </p>

        <!-- H1 -->
        <h1 id="hero-h1" class="text-6xl lg:text-8xl font-display font-bold text-white leading-[1.0] mb-6 opacity-0" style="letter-spacing: -0.03em;">
          Pain Control Clinic in
          <span class="text-gradient-gold block mt-1">St. Louis</span>
        </h1>

        <p id="hero-sub1" class="text-white/75 text-lg leading-relaxed mb-2 opacity-0">
          Orthopedic Clinic · Weight Loss Clinic · Sports Medicine Clinic
        </p>

        <p id="hero-sub2" class="text-white/60 text-base leading-relaxed mb-10 max-w-xl opacity-0">
          Serving south St. Louis County since 2019. Expert care for neuropathy, chronic pain, joint conditions, and more — personalized to your recovery.
        </p>

        <!-- Journey steps -->
        <div id="journey-steps" class="flex items-center gap-4 mb-10 opacity-0">
          {[
            { n: '1', label: 'Book Appointment' },
            { n: '2', label: 'Custom Treatment Plan' },
            { n: '3', label: 'Reclaim Your Life' },
          ].map((step, i) => (
            <div class="flex items-center gap-3">
              {i > 0 && <div class="w-8 h-px bg-brand-gold/50 hidden sm:block journey-arrow" style="transform-origin: left center;"></div>}
              <div class="flex items-center gap-2">
                <div class="journey-num w-9 h-9 rounded-full bg-brand-gold flex items-center justify-center text-white font-display font-bold text-sm shrink-0 shadow-brand">
                  {step.n}
                </div>
                <span class="text-white/75 text-sm font-medium hidden sm:block">{step.label}</span>
              </div>
            </div>
          ))}
        </div>

        <!-- CTAs -->
        <div id="hero-ctas" class="flex flex-col sm:flex-row gap-4 opacity-0">
          <a
            href={BOOKING_URL}
            id="hero-cta"
            class="btn-shine relative overflow-hidden inline-flex items-center justify-center gap-2 bg-gradient-to-r from-brand-gold to-brand-gold-dark text-white font-semibold px-8 py-4 rounded-xl text-base shadow-brand-lg hover:shadow-brand-xl transition-shadow"
          >
            <span class="shine-sweep absolute inset-0 pointer-events-none" style="background: linear-gradient(90deg, transparent, rgba(255,255,255,0.28), transparent); transform: translateX(-110%);"></span>
            <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5"/></svg>
            Book Appointment
          </a>
          <a
            href={`tel:${SITE_PHONE_DISPLAY.replace(/\D/g,'')}`}
            class="inline-flex items-center justify-center gap-2 bg-white/10 backdrop-blur-sm border border-white/20 text-white font-semibold px-8 py-4 rounded-xl text-base hover:bg-white/15 transition-colors"
          >
            <svg class="w-4 h-4 text-brand-gold shrink-0" fill="currentColor" viewBox="0 0 20 20"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/></svg>
            {SITE_PHONE_DISPLAY}
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- ── TRUST BAR ── -->
  <section class="bg-white border-b border-amber-100/60 py-4">
    <div class="container">
      <div class="flex flex-wrap items-center justify-center gap-6 lg:gap-10">

        <!-- Google Rating -->
        <div class="flex items-center gap-2 text-sm">
          <div class="flex gap-0.5">
            {[1,2,3,4,5].map(() => (
              <svg class="w-4 h-4 text-brand-gold" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            ))}
          </div>
          <span class="font-bold text-brand-navy">4.9</span>
          <span class="text-brand-body/60">Google Reviews</span>
        </div>

        <div class="w-px h-5 bg-gray-200 hidden sm:block"></div>

        <!-- Medicare -->
        <div class="flex items-center gap-2 text-sm text-brand-body/70">
          <svg class="w-4 h-4 text-brand-teal shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z"/></svg>
          <span class="font-semibold text-brand-navy">Medicare Accepted</span>
        </div>

        <div class="w-px h-5 bg-gray-200 hidden sm:block"></div>

        <!-- Same-week -->
        <div class="flex items-center gap-2 text-sm text-brand-body/70">
          <svg class="w-4 h-4 text-brand-teal shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5"/></svg>
          <span class="font-semibold text-brand-navy">Same-Week Appointments</span>
        </div>

        <div class="w-px h-5 bg-gray-200 hidden sm:block"></div>

        <!-- Location -->
        <div class="flex items-center gap-2 text-sm text-brand-body/70">
          <svg class="w-4 h-4 text-brand-teal shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"/></svg>
          <span class="font-semibold text-brand-navy">South St. Louis County</span>
        </div>

      </div>
    </div>
  </section>

  <!-- ── STATS ── -->
  <section class="bg-brand-navy py-14 relative overflow-hidden">
    <div aria-hidden="true" class="absolute inset-0 opacity-10" style="background: linear-gradient(135deg, transparent 40%, rgba(200,160,74,0.3) 100%);"></div>
    <div class="container relative z-10">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 text-center">
        {stats.map(s => (
          <div class="gsap-reveal">
            <div
              class="stat-number text-5xl lg:text-6xl text-brand-gold mb-2"
              data-target={s.value}
              data-suffix={s.suffix}
            >
              {s.value}{s.suffix}
            </div>
            <p class="text-white/60 text-sm font-medium uppercase tracking-wider">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── SERVICES — Pain Control ── -->
  <section class="section bg-brand-warm">
    <div class="container">
      <div class="flex items-end justify-between mb-10 gsap-reveal">
        <div>
          <p class="eyebrow text-brand-gold mb-3">Pain Management</p>
          <h2 class="text-4xl lg:text-5xl font-display font-bold text-brand-navy leading-tight" style="letter-spacing: -0.02em;">
            Pain Control Services<br class="hidden lg:block" /> in St. Louis, MO
          </h2>
        </div>
        <a href="/pain-control/" class="hidden lg:inline-flex items-center gap-1 text-brand-teal font-semibold text-sm hover:underline shrink-0 mb-1">
          View All
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/></svg>
        </a>
      </div>
      <div class="card-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {allServices.filter(s => s.category === 'Pain Control').map(s => (
          <ServiceCard name={s.name} url={s.url} description={s.description} image={s.image} imageAlt={`${s.name} in St. Louis, MO`} />
        ))}
      </div>
      <div class="mt-6 lg:hidden text-center">
        <a href="/pain-control/" class="text-brand-teal font-semibold text-sm hover:underline">View All Pain Control Services →</a>
      </div>
    </div>
  </section>

  <!-- ── SERVICES — Orthopedic + More ── -->
  <section class="section bg-white">
    <div class="container">
      <div class="flex items-end justify-between mb-10 gsap-reveal">
        <div>
          <p class="eyebrow text-brand-gold mb-3">Orthopedic &amp; Regenerative</p>
          <h2 class="text-4xl lg:text-5xl font-display font-bold text-brand-navy leading-tight" style="letter-spacing: -0.02em;">
            Orthopedic Clinic<br class="hidden lg:block" /> in St. Louis, MO
          </h2>
        </div>
        <a href="/orthopedic/" class="hidden lg:inline-flex items-center gap-1 text-brand-teal font-semibold text-sm hover:underline shrink-0 mb-1">
          View All
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/></svg>
        </a>
      </div>
      <div class="card-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {allServices.filter(s => ['Orthopedic','Weight Loss','Sports Medicine'].includes(s.category)).map(s => (
          <ServiceCard name={s.name} url={s.url} description={s.description} image={s.image} imageAlt={`${s.name} in St. Louis, MO`} />
        ))}
      </div>
      <div class="flex justify-center gap-6 mt-6 text-sm">
        <a href="/weight-loss/" class="text-brand-teal font-semibold hover:underline">Weight Loss Clinic →</a>
        <a href="/sports-medicine/" class="text-brand-teal font-semibold hover:underline">Sports Medicine →</a>
      </div>
    </div>
  </section>

  <!-- ── CONDITIONS ── -->
  <section class="section bg-brand-warm">
    <div class="container">
      <div class="flex items-end justify-between mb-10 gsap-reveal">
        <div>
          <p class="eyebrow text-brand-gold mb-3">Conditions We Treat</p>
          <h2 class="text-4xl lg:text-5xl font-display font-bold text-brand-navy leading-tight" style="letter-spacing: -0.02em;">
            Conditions We Treat<br class="hidden lg:block" /> in St. Louis
          </h2>
        </div>
        <a href="/conditions/" class="hidden lg:inline-flex items-center gap-1 text-brand-teal font-semibold text-sm hover:underline shrink-0 mb-1">
          View All
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/></svg>
        </a>
      </div>
      <div class="card-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        {allConditions.map(c => (
          <ConditionCard name={c.name} url={c.url} image={c.image} imageAlt={`${c.name} at St. Louis Pain Center`} />
