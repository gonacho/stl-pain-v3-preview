  <!-- ── CTA ── -->
  <CTA />

</BaseLayout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('astro:page-load', () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      // Ensure elements are visible if motion is reduced
      ['#hero-eyebrow','#hero-h1','#hero-sub1','#hero-sub2','#journey-steps','#hero-ctas'].forEach(sel => {
        const el = document.querySelector<HTMLElement>(sel);
        if (el) { el.style.opacity = '1'; }
      });
      return;
    }

    // ── Hero entrance timeline ──
    const tl = gsap.timeline({ delay: 0.15 });

    tl.to('#hero-eyebrow', { autoAlpha: 1, y: 0, duration: 0.5, ease: 'power3.out' })
      .to('#hero-h1', { autoAlpha: 1, y: 0, duration: 0.65, ease: 'power3.out' }, '-=0.25')
      .to('#hero-sub1', { autoAlpha: 1, y: 0, duration: 0.5, ease: 'power3.out' }, '-=0.3')
      .to('#hero-sub2', { autoAlpha: 1, y: 0, duration: 0.5, ease: 'power3.out' }, '-=0.3')
      .to('#journey-steps', { autoAlpha: 1, duration: 0.4, ease: 'power3.out' }, '-=0.2')
      .from('.journey-num', {
        scale: 0.6,
        autoAlpha: 0,
        duration: 0.4,
        stagger: 0.12,
        ease: 'back.out(1.7)',
      }, '-=0.35')
      .from('.journey-arrow', {
        scaleX: 0,
        duration: 0.3,
        stagger: 0.1,
        ease: 'power2.out',
      }, '-=0.3')
      .to('#hero-ctas', { autoAlpha: 1, y: 0, duration: 0.5, ease: 'power3.out' }, '-=0.2');

    // ── Magnetic hero CTA ──
    const heroCta = document.getElementById('hero-cta');
    if (heroCta) {
      const xTo = gsap.quickTo(heroCta, 'x', { duration: 0.3, ease: 'power3' });
      const yTo = gsap.quickTo(heroCta, 'y', { duration: 0.3, ease: 'power3' });
      heroCta.addEventListener('mousemove', (e: MouseEvent) => {
        const r = heroCta.getBoundingClientRect();
        xTo((e.clientX - r.left - r.width / 2) * 0.3);
        yTo((e.clientY - r.top - r.height / 2) * 0.3);
      });
      heroCta.addEventListener('mouseleave', () => { xTo(0); yTo(0); });
    }
  });
</script>
