  <!-- ── WHY US ── -->
  <section class="section bg-brand-navy relative overflow-hidden">
    <div aria-hidden="true" class="absolute -top-32 -right-32 w-96 h-96 rounded-full opacity-15 blur-3xl" style="background: radial-gradient(circle, #C8A04A 0%, transparent 70%);"></div>
    <div aria-hidden="true" class="absolute bottom-0 left-0 w-64 h-64 rounded-full opacity-10 blur-3xl" style="background: radial-gradient(circle, #0E7C9E 0%, transparent 70%);"></div>
