---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LocalBusinessSchema from '../components/schemas/LocalBusinessSchema.astro';
import WebPageSchema from '../components/schemas/WebPageSchema.astro';
import BreadcrumbSchema from '../components/schemas/BreadcrumbSchema.astro';
import FAQPageSchema from '../components/schemas/FAQPageSchema.astro';
import ContactForm from '../components/ContactForm.astro';
import FAQ from '../components/FAQ.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { SITE_PHONE_DISPLAY, SITE_ADDRESS, SITE_HOURS, GBP_SHARE_URL } from '../data/site-config';

const page = await getEntry('pages', 'contact');
if (!page) throw new Error('contact page content not found');

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Contact', url: '/contact/' },
];
---
<BaseLayout title={page.data.title} description={page.data.description} image={page.data.heroImage}>
  <Fragment slot="schema">
    <LocalBusinessSchema />
    <WebPageSchema
      title={page.data.title}
      description={page.data.description}
      url="/contact/"
      datePublished={page.data.publishDate}
      dateModified={page.data.lastEdited}
    />
    <BreadcrumbSchema items={breadcrumbs} />
    {page.data.faqs.length > 0 && <FAQPageSchema faqs={page.data.faqs} />}
  </Fragment>

  <!-- Hero -->
  <section class="bg-gradient-to-br from-brand-navy to-brand-navy-dark py-16 relative overflow-hidden">
    <div aria-hidden="true" class="absolute top-0 right-0 w-64 h-64 rounded-full bg-brand-gold/10 blur-3xl"></div>
    <div class="container relative z-10">
      <Breadcrumb items={breadcrumbs} />
      <h1 class="text-5xl lg:text-6xl font-display font-bold text-white mt-4 mb-4 gsap-reveal" style="letter-spacing:-0.02em">{page.data.h1}</h1>
      <p class="text-white/70 text-lg max-w-2xl gsap-reveal">{page.data.description}</p>
    </div>
  </section>

  <!-- Contact grid -->
  <section class="section bg-brand-warm">
    <div class="container max-w-5xl">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <!-- Left: contact info -->
        <div>
          <h2 class="text-3xl font-display font-bold text-brand-navy mb-8 gsap-reveal">Reach Us Directly</h2>

          <div class="space-y-6">
            <!-- Phone -->
            <div class="flex items-start gap-4 gsap-reveal">
              <div class="w-10 h-10 rounded-xl bg-brand-gold/10 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </div>
              <div>
                <div class="text-sm font-semibold text-brand-navy mb-1">Phone</div>
                <a href={`tel:${SITE_PHONE_DISPLAY.replace(/\D/g,'')}`} class="text-brand-teal hover:text-brand-navy text-lg font-bold transition-colors">{SITE_PHONE_DISPLAY}</a>
              </div>
            </div>

            <!-- Address -->
            <div class="flex items-start gap-4 gsap-reveal">
              <div class="w-10 h-10 rounded-xl bg-brand-gold/10 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <div>
                <div class="text-sm font-semibold text-brand-navy mb-1">Address</div>
                <address class="not-italic text-brand-body/80 text-sm leading-relaxed">
                  {SITE_ADDRESS.street}<br />
                  {SITE_ADDRESS.city}, {SITE_ADDRESS.state} {SITE_ADDRESS.zip}
                </address>
                <a href={GBP_SHARE_URL} target="_blank" rel="noopener noreferrer" class="text-brand-teal text-sm hover:underline mt-1 inline-block">Get Directions</a>
              </div>
            </div>

            <!-- Hours -->
            <div class="flex items-start gap-4 gsap-reveal">
              <div class="w-10 h-10 rounded-xl bg-brand-gold/10 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <div>
                <div class="text-sm font-semibold text-brand-navy mb-1">Office Hours</div>
                <div class="text-brand-body/80 text-sm">{SITE_HOURS}</div>
              </div>
            </div>
          </div>

          <!-- Map embed placeholder -->
          <div class="mt-8 rounded-2xl overflow-hidden border border-amber-100 shadow-brand gsap-reveal">
            <iframe
              title="St. Louis Pain Center location map"
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3120.7!2d-90.3050876!3d38.4826929!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x70ddcf5cd28b1f58!2sSt.+Louis+Pain+Center!5e0!3m2!1sen!2sus!4v1"
              width="100%"
              height="220"
              style="border:0;"
              allowfullscreen={false}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
        </div>

        <!-- Right: form -->
        <div>
          <h2 class="text-3xl font-display font-bold text-brand-navy mb-8 gsap-reveal">Request an Appointment</h2>
          <ContactForm />
        </div>
      </div>
    </div>
  </section>

  {page.data.faqs.length > 0 && <FAQ faqs={page.data.faqs} />}
</BaseLayout>
