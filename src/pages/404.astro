---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_NAME, SITE_PHONE_DISPLAY } from '../data/site-config';
---
<BaseLayout
  title={`Page Not Found | ${SITE_NAME}`}
  description="The page you were looking for could not be found. Return to St. Louis Pain Center to find pain management services, conditions, and contact information."
  noIndex={true}
>
  <section class="bg-gradient-to-br from-brand-navy to-brand-navy-dark min-h-[70vh] flex items-center relative overflow-hidden">
    <div aria-hidden="true" class="absolute top-0 right-0 w-96 h-96 rounded-full bg-brand-gold/10 blur-3xl"></div>
    <div aria-hidden="true" class="absolute bottom-0 left-0 w-64 h-64 rounded-full bg-brand-teal/10 blur-3xl"></div>
    <div class="container relative z-10 text-center">
      <div class="text-brand-gold font-display font-bold text-8xl lg:text-9xl mb-4 gsap-reveal" aria-hidden="true">404</div>
      <h1 class="text-3xl lg:text-4xl font-display font-bold text-white mb-4 gsap-reveal">Page Not Found</h1>
      <p class="text-white/70 text-lg max-w-lg mx-auto mb-10 gsap-reveal">
        We couldn't find the page you were looking for. It may have moved or been removed. Use the links below to find what you need.
      </p>

      <!-- Quick links -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 max-w-3xl mx-auto mb-12 gsap-reveal">
        <a href="/" class="bg-white/10 hover:bg-white/20 border border-white/20 text-white rounded-xl p-4 text-sm font-semibold transition-colors">
          Home
        </a>
        <a href="/conditions/" class="bg-white/10 hover:bg-white/20 border border-white/20 text-white rounded-xl p-4 text-sm font-semibold transition-colors">
          Conditions
        </a>
        <a href="/pain-control/" class="bg-white/10 hover:bg-white/20 border border-white/20 text-white rounded-xl p-4 text-sm font-semibold transition-colors">
          Pain Control
        </a>
        <a href="/orthopedic/" class="bg-white/10 hover:bg-white/20 border border-white/20 text-white rounded-xl p-4 text-sm font-semibold transition-colors">
          Orthopedic
        </a>
      </div>

      <div class="flex flex-col sm:flex-row gap-4 justify-center gsap-reveal">
        <a
          href="/contact/"
          class="btn-shine bg-gradient-to-r from-brand-gold to-brand-gold-dark text-white font-semibold px-8 py-4 rounded-xl text-base shadow-brand"
        >
          Book Appointment
        </a>
        <a
          href={`tel:${SITE_PHONE_DISPLAY.replace(/\D/g,'')}`}
          class="border border-white/30 text-white font-semibold px-8 py-4 rounded-xl text-base hover:border-white/60 transition-colors"
        >
          Call {SITE_PHONE_DISPLAY}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
