---
interface FAQItem {
  question: string;
  answer: string;
}
interface Props {
  faqs: FAQItem[];
  title?: string;
}
const { faqs, title = 'Frequently Asked Questions' } = Astro.props;
---
<section class="section bg-brand-warm">
  <div class="container max-w-3xl">
    <h2 class="text-4xl font-display font-bold text-brand-navy text-center mb-12 gsap-reveal">{title}</h2>
    <div class="space-y-3" id="faq-list">
      {faqs.map((faq, i) => (
        <div class="faq-item bg-white rounded-2xl border border-amber-100 shadow-brand-sm overflow-hidden">
          <button
            class="w-full flex items-center justify-between text-left px-6 py-5 font-display font-semibold text-brand-navy hover:text-brand-gold transition-colors"
            aria-expanded="false"
            data-faq-toggle
          >
            <span>{faq.question}</span>
            <span class="faq-icon flex-shrink-0 ml-4 w-6 h-6 rounded-full border-2 border-brand-gold text-brand-gold flex items-center justify-center text-sm transition-transform">
              +
            </span>
          </button>
          <div class="faq-answer overflow-hidden" style="height: 0;">
            <div class="px-6 pb-5 text-brand-body text-sm leading-relaxed">{faq.answer}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  document.addEventListener('astro:page-load', () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.querySelectorAll('.faq-answer').forEach(el => {
        (el as HTMLElement).style.height = 'auto';
      });
      return;
    }

    document.querySelectorAll('[data-faq-toggle]').forEach(btn => {
      btn.addEventListener('click', () => {
        const item = btn.closest('.faq-item')!;
        const answer = item.querySelector('.faq-answer') as HTMLElement;
        const icon = item.querySelector('.faq-icon') as HTMLElement;
        const isOpen = btn.getAttribute('aria-expanded') === 'true';

        if (isOpen) {
          btn.setAttribute('aria-expanded', 'false');
          icon.textContent = '+';
          gsap.to(icon, { rotation: 0, duration: 0.25, ease: 'power2.out' });
          gsap.to(answer, { height: 0, duration: 0.3, ease: 'power2.out' });
        } else {
          btn.setAttribute('aria-expanded', 'true');
          icon.textContent = '−';
          gsap.to(icon, { rotation: 45, duration: 0.25, ease: 'power2.out' });
          const inner = answer.querySelector('div') as HTMLElement;
          const h = inner.offsetHeight;
          gsap.fromTo(answer, { height: 0 }, { height: h, duration: 0.35, ease: 'power2.out',
            onComplete: () => { answer.style.height = 'auto'; }
          });
          // Fade in text
          gsap.from(inner, { autoAlpha: 0, y: 4, duration: 0.25, delay: 0.1, ease: 'power2.out' });
        }
      });
    });
  });
</script>
