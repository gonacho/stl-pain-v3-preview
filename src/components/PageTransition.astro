<!-- Gold page transition overlay + scroll progress bar -->
<div
  id="page-transition"
  aria-hidden="true"
  class="pointer-events-none fixed inset-0 z-[200] opacity-0"
  style="background: linear-gradient(135deg, #1B3A5C 0%, #0F1F30 60%, rgba(200,160,74,0.8) 100%);"
></div>
<div id="scroll-progress" aria-hidden="true"></div>

<script>
  import { gsap } from 'gsap';

  document.addEventListener('astro:before-swap', () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const el = document.getElementById('page-transition');
    if (el) gsap.to(el, { autoAlpha: 1, duration: 0.28, ease: 'power2.inOut' });
  });

  document.addEventListener('astro:after-swap', () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const el = document.getElementById('page-transition');
    if (el) gsap.to(el, { autoAlpha: 0, duration: 0.35, delay: 0.08, ease: 'power2.inOut' });
  });

  // Scroll progress bar
  function updateProgress() {
    const bar = document.getElementById('scroll-progress');
    if (!bar) return;
    const scrollTop = window.scrollY;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    const pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
    bar.style.width = Math.min(100, pct) + '%';
  }

  document.addEventListener('astro:page-load', () => {
    window.addEventListener('scroll', updateProgress, { passive: true });
    updateProgress();
  });
</script>
