<div
  id="page-transition"
  aria-hidden="true"
  class="pointer-events-none fixed inset-0 z-[200] bg-[#C8A04A] opacity-0"
></div>

<script>
  import { gsap } from 'gsap';

  document.addEventListener('astro:before-swap', () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const el = document.getElementById('page-transition');
    if (el) gsap.to(el, { autoAlpha: 1, duration: 0.25, ease: 'power2.inOut' });
  });

  document.addEventListener('astro:after-swap', () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const el = document.getElementById('page-transition');
    if (el) gsap.to(el, { autoAlpha: 0, duration: 0.35, delay: 0.05, ease: 'power2.inOut' });
  });
</script>
