---
---
<form
  id="contact-form"
  class="bg-white rounded-2xl border border-amber-100 shadow-brand p-8"
  method="POST"
  action="/api/contact"
  novalidate
>
  <!-- Honeypot -->
  <div class="absolute opacity-0 pointer-events-none h-0 overflow-hidden" aria-hidden="true">
    <label for="website">Website</label>
    <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <div class="form-field">
      <label for="first-name" class="block text-sm font-semibold text-brand-navy mb-1.5">First Name <span class="text-red-500" aria-hidden="true">*</span></label>
      <input
        id="first-name"
        name="firstName"
        type="text"
        required
        autocomplete="given-name"
        class="w-full px-4 py-3 rounded-xl border border-gray-200 text-brand-body text-sm focus:outline-none focus:border-brand-gold focus:ring-2 focus:ring-brand-gold/30 transition-all"
        placeholder="Jane"
      />
    </div>
    <div class="form-field">
      <label for="last-name" class="block text-sm font-semibold text-brand-navy mb-1.5">Last Name <span class="text-red-500" aria-hidden="true">*</span></label>
      <input
        id="last-name"
        name="lastName"
        type="text"
        required
        autocomplete="family-name"
        class="w-full px-4 py-3 rounded-xl border border-gray-200 text-brand-body text-sm focus:outline-none focus:border-brand-gold focus:ring-2 focus:ring-brand-gold/30 transition-all"
        placeholder="Smith"
      />
    </div>
  </div>

  <div class="form-field mt-5">
    <label for="email" class="block text-sm font-semibold text-brand-navy mb-1.5">Email Address <span class="text-red-500" aria-hidden="true">*</span></label>
    <input
      id="email"
      name="email"
      type="email"
      required
      autocomplete="email"
      class="w-full px-4 py-3 rounded-xl border border-gray-200 text-brand-body text-sm focus:outline-none focus:border-brand-gold focus:ring-2 focus:ring-brand-gold/30 transition-all"
      placeholder="jane@example.com"
    />
  </div>

  <div class="form-field mt-5">
    <label for="phone" class="block text-sm font-semibold text-brand-navy mb-1.5">Phone Number</label>
    <input
      id="phone"
      name="phone"
      type="tel"
      autocomplete="tel"
      class="w-full px-4 py-3 rounded-xl border border-gray-200 text-brand-body text-sm focus:outline-none focus:border-brand-gold focus:ring-2 focus:ring-brand-gold/30 transition-all"
      placeholder="(314) 555-0000"
    />
  </div>

  <div class="form-field mt-5">
    <label for="service" class="block text-sm font-semibold text-brand-navy mb-1.5">Service of Interest</label>
    <select
      id="service"
      name="service"
      class="w-full px-4 py-3 rounded-xl border border-gray-200 text-brand-body text-sm focus:outline-none focus:border-brand-gold focus:ring-2 focus:ring-brand-gold/30 transition-all bg-white"
    >
      <option value="">Select a service...</option>
      <option value="Neuropathy Treatment">Neuropathy Treatment</option>
      <option value="Nerve Blocks">Nerve Blocks</option>
      <option value="Injection Therapy">Injection Therapy</option>
      <option value="Hyaluronic Acid Injections">Hyaluronic Acid Injections</option>
      <option value="PRP Therapy">PRP Therapy</option>
      <option value="Regenerative Therapy">Regenerative Therapy</option>
      <option value="Kyphoplasty">Kyphoplasty</option>
      <option value="Medication Management">Medication Management</option>
      <option value="Neuromodulation Technique">Neuromodulation Technique</option>
      <option value="Medical Weight Loss">Medical Weight Loss</option>
      <option value="Physical Therapy">Physical Therapy</option>
      <option value="Other / Not Sure">Other / Not Sure</option>
    </select>
  </div>

  <div class="form-field mt-5">
    <label for="message" class="block text-sm font-semibold text-brand-navy mb-1.5">Message</label>
    <textarea
      id="message"
      name="message"
      rows="4"
      class="w-full px-4 py-3 rounded-xl border border-gray-200 text-brand-body text-sm focus:outline-none focus:border-brand-gold focus:ring-2 focus:ring-brand-gold/30 transition-all resize-none"
      placeholder="Tell us about your symptoms or questions..."
    ></textarea>
  </div>

  <div class="mt-2 text-xs text-brand-body/50">
    By submitting, you agree to our <a href="/hipaa-privacy/" class="text-brand-teal hover:underline">HIPAA Privacy Policy</a>.
  </div>

  <!-- Submit button -->
  <button
    type="submit"
    id="form-submit-btn"
    class="btn-shine mt-6 w-full bg-gradient-to-r from-brand-gold to-brand-gold-dark text-white font-semibold px-8 py-4 rounded-xl text-base shadow-brand hover:shadow-brand-lg transition-shadow"
  >
    Request Appointment
  </button>

  <!-- Success state -->
  <div id="form-success" class="hidden mt-6 p-5 bg-green-50 border border-green-200 rounded-xl text-center">
    <svg class="w-10 h-10 text-green-500 mx-auto mb-3" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2.5">
      <path class="check-path" d="M8 20l8 8 16-16" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="100" stroke-dashoffset="100"/>
    </svg>
    <p class="font-semibold text-green-800 mb-1">Thank you! We'll be in touch soon.</p>
    <p class="text-sm text-green-700">Our team typically responds within 1 business day.</p>
  </div>

  <!-- Error state -->
  <div id="form-error" class="hidden mt-4 p-4 bg-red-50 border border-red-200 rounded-xl text-sm text-red-700">
    Something went wrong. Please call us at <a href="tel:3148462100" class="font-semibold underline">(314) 846-2100</a>.
  </div>
</form>

<script>
  import { gsap } from 'gsap';

  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('contact-form') as HTMLFormElement;
    if (!form) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('form-submit-btn') as HTMLButtonElement;
      const successEl = document.getElementById('form-success');
      const errorEl = document.getElementById('form-error');
      
      // Honeypot check
      const honeypot = form.querySelector<HTMLInputElement>('[name="website"]');
      if (honeypot?.value) return;

      btn.disabled = true;
      btn.textContent = 'Sending...';

      try {
        const data = new FormData(form);
        const res = await fetch('/api/contact', {
          method: 'POST',
          body: JSON.stringify(Object.fromEntries(data)),
          headers: { 'Content-Type': 'application/json' },
        });

        if (!res.ok) throw new Error('Network error');

        form.style.display = 'none';
        if (successEl) {
          successEl.classList.remove('hidden');
          gsap.fromTo(successEl, { autoAlpha: 0, y: 20 }, { autoAlpha: 1, y: 0, duration: 0.4, ease: 'back.out(1.7)' });
          // Draw check animation
          const path = successEl.querySelector('.check-path') as SVGPathElement;
          if (path) gsap.to(path, { strokeDashoffset: 0, duration: 0.5, delay: 0.2, ease: 'power2.out' });
        }
      } catch {
        btn.disabled = false;
        btn.textContent = 'Request Appointment';
        if (errorEl) {
          errorEl.classList.remove('hidden');
          gsap.from(errorEl, { autoAlpha: 0, y: 10, duration: 0.3 });
        }
      }
    });

    // Focus glow animations
    form.querySelectorAll('input, textarea, select').forEach(field => {
      field.addEventListener('focus', () => {
        gsap.to(field, { scale: 1.005, duration: 0.15, ease: 'power2.out' });
      });
      field.addEventListener('blur', () => {
        gsap.to(field, { scale: 1, duration: 0.15, ease: 'power2.out' });
      });
    });
  });
</script>
