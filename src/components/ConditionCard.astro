---
interface Props {
  name: string;
  url: string;
  snippet?: string;
  image?: string;
  imageAlt?: string;
}
const { name, url, snippet, image, imageAlt } = Astro.props;
---
{image ? (
  <a
    href={url}
    class="card group relative block rounded-2xl overflow-hidden border border-amber-100/60 shadow-brand hover:shadow-brand-lg hover:-translate-y-1 transition-all duration-300"
    style="aspect-ratio: 4/3;"
  >
    <img
      src={image}
      alt={imageAlt ?? name}
      width="400"
      height="300"
      loading="lazy"
      decoding="async"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
    />
    <!-- dark overlay that deepens on hover -->
    <div class="absolute inset-0 bg-gradient-to-t from-brand-navy/80 via-brand-navy/20 to-transparent group-hover:from-brand-navy/90 transition-all duration-300"></div>
    <!-- content overlay -->
    <div class="absolute bottom-0 left-0 right-0 p-4">
      <span class="font-display font-bold text-white text-base leading-snug block" style="letter-spacing: -0.01em;">{name}</span>
      {snippet && <p class="text-white/70 text-xs mt-1 leading-relaxed line-clamp-2">{snippet}</p>}
      <!-- learn more arrow -->
      <div class="flex items-center gap-1 mt-2 text-brand-gold text-xs font-semibold opacity-0 group-hover:opacity-100 translate-y-1 group-hover:translate-y-0 transition-all duration-200">
        Learn More
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
      </div>
    </div>
  </a>
) : (
  <a
    href={url}
    class="card group flex items-start gap-3 bg-white rounded-xl border border-amber-100 shadow-brand-sm p-4 hover:shadow-brand hover:border-brand-gold/30 transition-all duration-200"
  >
    <div class="w-8 h-8 rounded-lg bg-brand-gold/10 flex items-center justify-center shrink-0 mt-0.5 group-hover:bg-brand-gold/20 transition-colors duration-200">
      <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
    </div>
    <div>
      <span class="font-display font-semibold text-brand-navy text-sm group-hover:text-brand-gold transition-colors duration-200">{name}</span>
      {snippet && <p class="text-xs text-brand-body/70 mt-0.5 leading-relaxed">{snippet}</p>}
    </div>
  </a>
)}
