---
interface TestimonialItem {
  author: string;
  text: string;
  rating: number;
  condition?: string;
}

interface Props {
  testimonials: TestimonialItem[];
  title?: string;
}

const { testimonials, title = "What Our Patients Say" } = Astro.props;

// Initials for avatar
function initials(name: string) {
  return name.split(' ').map(p => p[0]).join('').slice(0, 2).toUpperCase();
}

// Gradient per author index for avatar ring color
const gradients = [
  'from-brand-gold to-amber-500',
  'from-brand-teal to-cyan-500',
  'from-brand-navy to-blue-600',
];
---
<section class="section bg-white relative overflow-hidden">
  <!-- Subtle background accent -->
  <div aria-hidden="true" class="absolute top-0 right-0 w-96 h-96 rounded-full opacity-5 blur-3xl" style="background: radial-gradient(circle, #C8A04A 0%, transparent 70%);"></div>

  <div class="container relative z-10">
    <div class="text-center mb-14 gsap-reveal">
      <p class="eyebrow text-brand-gold mb-3">Patient Stories</p>
      <h2 class="text-4xl lg:text-5xl font-display font-bold text-brand-navy" style="letter-spacing: -0.02em;">{title}</h2>
    </div>

    <div class="card-grid grid grid-cols-1 md:grid-cols-3 gap-6">
      {testimonials.map((t, i) => (
        <article class="card bg-brand-warm rounded-2xl p-7 border border-amber-100/60 shadow-brand flex flex-col gap-5 hover:shadow-brand-lg transition-shadow duration-300">

          <!-- Stars -->
          <div class="flex gap-1" aria-label={`${t.rating} out of 5 stars`}>
            {Array.from({ length: t.rating }).map(() => (
              <svg class="w-4 h-4 text-brand-gold" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>

          <!-- Quote mark -->
          <svg class="w-7 h-7 text-brand-gold/30 -mb-3" fill="currentColor" viewBox="0 0 32 32" aria-hidden="true">
            <path d="M9.352 4C4.456 7.456 1 13.12 1 19.36c0 5.088 3.072 8.064 6.624 8.064 3.36 0 5.856-2.688 5.856-5.856 0-3.168-2.208-5.472-5.088-5.472-.576 0-1.344.096-1.536.192.48-3.264 3.552-7.104 6.624-9.024L9.352 4zm16.512 0c-4.8 3.456-8.256 9.12-8.256 15.36 0 5.088 3.072 8.064 6.624 8.064 3.264 0 5.856-2.688 5.856-5.856 0-3.168-2.304-5.472-5.184-5.472-.576 0-1.248.096-1.44.192.48-3.264 3.456-7.104 6.528-9.024L25.864 4z"/>
          </svg>

          <!-- Review text -->
          <blockquote class="text-brand-body text-sm leading-relaxed flex-1 italic">
            "{t.text}"
          </blockquote>

          <!-- Author footer -->
          <footer class="flex items-center gap-3 pt-2 border-t border-amber-100">
            <!-- Gradient avatar -->
            <div class={`w-10 h-10 rounded-full bg-gradient-to-br ${gradients[i % gradients.length]} flex items-center justify-center text-white font-bold text-xs shrink-0`}>
              {initials(t.author)}
            </div>
            <div>
              <cite class="not-italic font-semibold text-brand-navy text-sm block">{t.author}</cite>
              {t.condition
                ? <p class="text-xs text-brand-teal">{t.condition}</p>
                : <p class="text-xs text-brand-body/50">Verified Patient</p>
              }
            </div>
            <!-- Google G badge -->
            <div class="ml-auto shrink-0" title="Google Review">
              <svg class="w-5 h-5" viewBox="0 0 24 24" aria-label="Google Review">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
              </svg>
            </div>
          </footer>
        </article>
      ))}
    </div>

    <!-- Aggregate trust note -->
    <div class="flex items-center justify-center gap-2 mt-10 text-sm text-brand-body/50 gsap-reveal">
      <div class="flex gap-0.5">
        {[1,2,3,4,5].map(() => (
          <svg class="w-3.5 h-3.5 text-brand-gold" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
        ))}
      </div>
      <span>4.9 out of 5 — Based on 47 Google Reviews</span>
    </div>
  </div>
</section>
