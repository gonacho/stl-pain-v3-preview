---
import {
  SITE_URL, SITE_NAME, SITE_LEGAL_NAME, SITE_PHONE, SITE_ADDRESS,
  SAME_AS_URLS, NAICS_CODE, MEDICAL_SPECIALTY,
  GBP_CID, GBP_SHARE_URL
} from '../../data/site-config';

const schema = {
  "@context": "https://schema.org",
  "@type": "MedicalOrganization",
  "@id": `${SITE_URL}/#organization`,
  name: SITE_LEGAL_NAME,
  alternateName: SITE_NAME,
  url: SITE_URL,
  telephone: SITE_PHONE,
  address: {
    "@type": "PostalAddress",
    streetAddress: SITE_ADDRESS.street,
    addressLocality: SITE_ADDRESS.city,
    addressRegion: SITE_ADDRESS.state,
    postalCode: SITE_ADDRESS.zip,
    addressCountry: SITE_ADDRESS.country,
  },
  naics: NAICS_CODE,
  medicalSpecialty: {
    "@type": "MedicalSpecialty",
    name: MEDICAL_SPECIALTY.name,
    sameAs: MEDICAL_SPECIALTY.sameAs,
  },
  sameAs: [
    ...SAME_AS_URLS,
    `https://www.google.com/maps?cid=${GBP_CID}`,
    GBP_SHARE_URL,
  ].filter((v, i, a) => a.indexOf(v) === i),
};
---
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
